{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .video-product-section-{{ section.id }} {
    background-color: #F7F7F7;
  }

  .video-product-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .video-product-grid-{{ section.id }} {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3.5rem;
    }
  }

  /* Video Wrapper */
  .vwp-video-wrapper {
    position: relative;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: #0d0d0d;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    border: 1px solid #e0e0e0;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vwp-video-wrapper video,
  .vwp-video-wrapper iframe {
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .vwp-video-poster {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 2;
  }

  .vwp-video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.35);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.3s ease;
  }

  .vwp-video-wrapper:hover .vwp-video-overlay {
    background: rgba(0, 0, 0, 0.2);
  }

  .vwp-play-btn {
    width: 75px;
    height: 75px;
    background: #B48940;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 30px rgba(180, 137, 64, 0.6);
    transition: transform 0.3s ease, background 0.3s ease;
  }

  .vwp-video-wrapper:hover .vwp-play-btn {
    transform: scale(1.12);
    background: #d4a556;
  }

  .vwp-play-btn svg {
    width: 30px;
    height: 30px;
    fill: #ffffff;
    margin-left: 4px;
  }

  .vwp-video-label {
    margin-top: 1.2rem;
    color: #ffffff;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(0, 0, 0, 0.7);
    padding: 6px 16px;
    border-radius: 20px;
    border: 1px solid rgba(180, 137, 64, 0.6);
  }

  .vwp-video-tag {
    position: absolute;
    top: 15px;
    left: 15px;
    background: #B48940;
    color: #000000;
    padding: 6px 14px;
    border-radius: 4px;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    z-index: 6;
  }

  /* Product Card Styling */
  .vwp-product-card {
    background: #f2f2f2;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #e0e0e0;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .vwp-product-badge {
    position: absolute;
    top: 15px;
    right: 15px;
    background: #B48940;
    color: #000000;
    font-weight: 800;
    font-size: 1.1rem;
    padding: 6px 14px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    z-index: 5;
  }

  .vwp-product-image {
    width: 100%;
    background: #f9f9f9;
    padding: 2rem;
    text-align: center;
  }

  .vwp-product-image img {
    max-width: 100%;
    height: auto;
    object-fit: contain;
    max-height: 260px;
    border-radius: 8px;
  }

  .vwp-product-content {
    padding: 2rem;
    text-align: center;
  }

  .vwp-product-title {
    font-size: 2.1rem;
    font-weight: 800;
    color: #111111;
    text-transform: uppercase;
    margin-bottom: 0.8rem;
    letter-spacing: 0.04em;
  }

  .vwp-product-desc {
    font-size: 1.4rem;
    color: #555555;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .vwp-product-price {
    font-size: 2.6rem;
    font-weight: 800;
    color: #111111;
    margin-bottom: 1.8rem;
  }

  .vwp-product-btn {
    display: block;
    width: 100%;
    background: #000000;
    color: #ffffff !important;
    font-weight: 800;
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 1.4rem;
    border-radius: 6px;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .vwp-product-btn:hover {
    opacity: 0.85;
    color: #ffffff !important;
  }
{%- endstyle -%}

<div class="video-product-section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin text-center" style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; margin-bottom: 3rem;">
        <h2 class="{{ section.settings.heading_size }} title-with-highlight" style="--hightlight-color:{{ section.settings.title_highlight_color }}; text-align: center;">
          {{ section.settings.title }}
        </h2>
        {%- if section.settings.sub_title != blank -%}
          <p class="collection-list-sub-title" style="font-size: 2.0rem; color: #555555; margin-top: 1.0rem; margin-bottom: 0.5rem; text-align: center; line-height: 1.6; font-weight: 400; width: 100%; letter-spacing: 0.04rem;">
            {{ section.settings.sub_title }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="video-product-grid-{{ section.id }}">
      <!-- Left Column: Sales Pitch Video Placeholder -->
      <div class="vwp-video-col">
        <div class="vwp-video-wrapper">
          <span class="vwp-video-tag">SALES PITCH VIDEO</span>
          {% if section.settings.video_url != blank %}
            <iframe
              src="{{ section.settings.video_url }}"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          {% elsif section.settings.mp4_video_url != blank %}
            <video controls poster="{{ section.settings.video_poster | image_url: width: 1200 }}">
              <source src="{{ section.settings.mp4_video_url }}" type="video/mp4">
            </video>
          {% else %}
            <!-- Placeholder Video Cover & Play Button -->
            {% if section.settings.video_poster != blank %}
              <img
                src="{{ section.settings.video_poster | image_url: width: 1200 }}"
                alt="Sales Pitch Video Placeholder"
                class="vwp-video-poster"
                loading="lazy"
              >
            {% else %}
              <img
                src="{{ 'MEN_S_WORKOUT_PROGRAM.webp' | shopify_asset_url }}"
                alt="Sales Pitch Video Placeholder"
                class="vwp-video-poster"
                loading="lazy"
              >
            {% endif %}
            <div class="vwp-video-overlay">
              <div class="vwp-play-btn">
                <svg viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
              <span class="vwp-video-label">WATCH SALES PITCH</span>
            </div>
          {% endif %}
        </div>
      </div>

      <!-- Right Column: Featured Product Card -->
      <div class="vwp-product-col">
        <div class="vwp-product-card">
          {% if section.settings.product_badge != blank %}
            <span class="vwp-product-badge">{{ section.settings.product_badge }}</span>
          {% endif %}

          <div class="vwp-product-image">
            {% if section.settings.product_image != blank %}
              <img
                src="{{ section.settings.product_image | image_url: width: 800 }}"
                alt="{{ section.settings.product_title }}"
                loading="lazy"
              >
            {% else %}
              <img
                src="{{ 'COUPLES_TRANSFORMATION_BUNDLE.webp' | shopify_asset_url }}"
                alt="The Complete Bundle"
                loading="lazy"
              >
            {% endif %}
          </div>

          <div class="vwp-product-content">
            <h3 class="vwp-product-title">
              {% if section.settings.product_title != blank %}
                {{ section.settings.product_title }}
              {% else %}
                THE COMPLETE BUNDLE
              {% endif %}
            </h3>

            <p class="vwp-product-desc">
              {% if section.settings.product_desc != blank %}
                {{ section.settings.product_desc }}
              {% else %}
                Get both Men's & Women's 16-week transformation programs and save big. Proven system designed for results.
              {% endif %}
            </p>

            <div class="vwp-product-price">
              {% if section.settings.product_price != blank %}
                {{ section.settings.product_price }}
              {% else %}
                $79.99
              {% endif %}
            </div>

            <a
              href="{{ section.settings.product_link | default: '/collections/couples-transformation-bundle' }}"
              class="vwp-product-btn"
            >
              {{ section.settings.button_label | default: 'VIEW BUNDLE' }}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Video with Product",
  "tag": "section",
  "class": "section section-video-with-product",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "<strong>PROGRAMS BUILT FOR REAL LIFE</strong>",
      "label": "Heading"
    },
    {
      "type": "color",
      "id": "title_highlight_color",
      "label": "Heading highlight color",
      "default": "#B48940"
    },
    {
      "type": "inline_richtext",
      "id": "sub_title",
      "default": "Proven 16-week systems designed to fit your lifestyle and get results.",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "header",
      "content": "Video Settings"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Video Poster Image / Placeholder"
    },
    {
      "type": "url",
      "id": "mp4_video_url",
      "label": "MP4 Video URL"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Embed Video URL (YouTube / Vimeo)"
    },
    {
      "type": "header",
      "content": "Product Card Settings"
    },
    {
      "type": "text",
      "id": "product_badge",
      "default": "BEST VALUE",
      "label": "Badge Text"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "product_title",
      "default": "THE COMPLETE BUNDLE",
      "label": "Product Title"
    },
    {
      "type": "textarea",
      "id": "product_desc",
      "default": "Get both Men's & Women's 16-week transformation programs and save big. Proven system designed for results.",
      "label": "Product Description"
    },
    {
      "type": "text",
      "id": "product_price",
      "default": "$79.99",
      "label": "Product Price"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "VIEW BUNDLE",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "product_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Video with Product"
    }
  ]
}
{% endschema %}
