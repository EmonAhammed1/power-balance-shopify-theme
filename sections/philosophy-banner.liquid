{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&display=swap');

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .philosophy-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#0d0d0d' }};
    color: #ffffff;
  }

  .philosophy-container-{{ section.id }} {
    background: #000000;
    border: 1px solid rgba(180, 137, 64, 0.25);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 12px 36px -4px rgba(180, 137, 64, 0.15), 0 0 20px rgba(0, 0, 0, 0.5);
    display: grid;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 990px) {
    .philosophy-container-{{ section.id }} {
      grid-template-columns: 1.35fr 0.65fr;
    }
  }

  /* Left Content */
  .philosophy-left {
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media screen and (min-width: 750px) {
    .philosophy-left {
      padding: 4rem 3.5rem;
    }
  }

  .philosophy-content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .philosophy-content-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 3.5rem;
    }
  }

  .philosophy-title {
    font-size: clamp(3.2rem, 5vw, 4.5rem);
    font-weight: 900;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.15;
    margin: 0 0 1.4rem 0;
  }

  .philosophy-desc {
    font-size: 1.8rem;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.6;
    margin: 0 0 2.5rem 0;
  }

  .philosophy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #B48940;
    color: #ffffff !important;
    font-weight: 800;
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 1.3rem 3.2rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.3s ease, box-shadow 0.3s ease;
    align-self: flex-start;
  }

  .philosophy-btn:hover {
    background: #cba052;
    box-shadow: 0 4px 18px rgba(180, 137, 64, 0.45);
    color: #ffffff !important;
  }

  /* 4 Pillars Grid */
  .philosophy-pillars-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.4rem 2rem;
  }

  .philosophy-pillar-item {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .philosophy-pillar-icon {
    width: 50px;
    height: 50px;
    min-width: 50px;
    border-radius: 50%;
    background: rgba(180, 137, 64, 0.12);
    border: 1px solid rgba(180, 137, 64, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .philosophy-pillar-icon svg {
    width: 25px;
    height: 25px;
    fill: none;
    stroke: #B48940;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .philosophy-pillar-text {
    display: flex;
    flex-direction: column;
  }

  .philosophy-pillar-heading {
    font-size: 1.65rem;
    font-weight: 800;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 3px 0;
  }

  .philosophy-pillar-sub {
    font-size: 1.35rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    line-height: 1.3;
  }

  /* Right Quote & Image/Video Banner */
  .philosophy-container-{{ section.id }} {
    min-height: {{ section.settings.desktop_section_height | default: 520 }}px !important;
  }

  .philosophy-right-{{ section.id }} {
    position: relative !important;
    width: 100% !important;
    min-height: {{ section.settings.desktop_media_height | default: 450 }}px !important;
    background-size: cover !important;
    background-position: center top !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-end !important;
    padding: 3.5rem 3rem !important;
    border-left: 1px solid rgba(180, 137, 64, 0.2) !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
  }

  @media screen and (min-width: 990px) {
    {% if section.settings.desktop_media_ratio == 'portrait' %}
      .philosophy-right-{{ section.id }} { aspect-ratio: 4 / 5 !important; min-height: 520px !important; }
    {% elsif section.settings.desktop_media_ratio == 'landscape' %}
      .philosophy-right-{{ section.id }} { aspect-ratio: 16 / 9 !important; min-height: 320px !important; }
    {% elsif section.settings.desktop_media_ratio == 'square' %}
      .philosophy-right-{{ section.id }} { aspect-ratio: 1 / 1 !important; min-height: 420px !important; }
    {% elsif section.settings.desktop_media_ratio == 'full' %}
      .philosophy-right-{{ section.id }} { height: 100% !important; min-height: 100% !important; }
    {% elsif section.settings.desktop_media_ratio == 'custom' %}
      .philosophy-right-{{ section.id }} { height: {{ section.settings.desktop_media_height }}px !important; min-height: {{ section.settings.desktop_media_height }}px !important; }
    {% endif %}
  }

  .philosophy-video-bg-{{ section.id }} {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    overflow: hidden !important;
    z-index: 0 !important;
  }

  .philosophy-video-bg-{{ section.id }} video,
  .philosophy-video-bg-{{ section.id }} iframe,
  .philosophy-video-bg-{{ section.id }} .video-tag {
    position: absolute !important;
    top: 50% !important;
    left: 50% !important;
    width: 100% !important;
    height: 100% !important;
    min-width: 100% !important;
    min-height: 100% !important;
    object-fit: {{ section.settings.video_fit | default: 'cover' }} !important;
    transform: translate(-50%, -50%) {% if section.settings.video_controls == false %}scale(1.02){% else %}scale(1){% endif %} !important;
    border: none !important;
    pointer-events: auto !important;
  }

  .philosophy-right-overlay {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.85) 100%) !important;
    z-index: 1 !important;
    pointer-events: none !important;
  }

  .philosophy-quote-wrapper {
    position: relative !important;
    z-index: 2 !important;
    pointer-events: none !important;
  }

  .philosophy-quote-text {
    font-size: 2.5rem !important;
    font-weight: 800 !important;
    color: #ffffff !important;
    text-transform: uppercase !important;
    letter-spacing: 0.04em !important;
    line-height: 1.3 !important;
    margin: 0 0 1.2rem 0 !important;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8) !important;
  }

  .philosophy-quote-author {
    font-family: 'Caveat', cursive, sans-serif !important;
    font-size: 4.2rem !important;
    color: #B48940 !important;
    font-weight: 700 !important;
    margin: 0 !important;
    letter-spacing: 0.02em !important;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8) !important;
    transform: rotate(-3deg) !important;
    display: inline-block !important;
  }

  @media screen and (max-width: 989px) {
    .philosophy-container-{{ section.id }} {
      min-height: auto !important;
    }
    .philosophy-text-col {
      text-align: center !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
    }
    .philosophy-title {
      font-size: 2.4rem !important;
      text-align: center !important;
    }
    .philosophy-desc {
      font-size: 1.55rem !important;
      text-align: center !important;
    }
    .philosophy-btn {
      font-size: 1.35rem !important;
      padding: 1.1rem 2.5rem !important;
      align-self: center !important;
      margin: 0 auto !important;
    }
    .philosophy-pillar-heading {
      font-size: 1.45rem !important;
    }
    .philosophy-pillar-sub {
      font-size: 1.25rem !important;
    }
    .philosophy-quote-text {
      font-size: 2.0rem !important;
    }
    .philosophy-quote-author {
      font-size: 3.4rem !important;
    }
    .philosophy-right-{{ section.id }} {
      min-height: {{ section.settings.mobile_media_height | default: 340 }}px !important;
      border-left: none !important;
      border-top: 1px solid rgba(180, 137, 64, 0.2) !important;
    }

    {% if section.settings.mobile_media_ratio == 'portrait' %}
      .philosophy-right-{{ section.id }} { aspect-ratio: 4 / 5 !important; min-height: 420px !important; }
    {% elsif section.settings.mobile_media_ratio == 'landscape' %}
      .philosophy-right-{{ section.id }} { aspect-ratio: 16 / 9 !important; min-height: 240px !important; }
    {% elsif section.settings.mobile_media_ratio == 'square' %}
      .philosophy-right-{{ section.id }} { aspect-ratio: 1 / 1 !important; min-height: 340px !important; }
    {% elsif section.settings.mobile_media_ratio == 'custom' %}
      .philosophy-right-{{ section.id }} { height: {{ section.settings.mobile_media_height }}px !important; min-height: {{ section.settings.mobile_media_height }}px !important; }
    {% endif %}
  }

  @media screen and (max-width: 550px) {
    .philosophy-pillars-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
{%- endstyle -%}

<div class="philosophy-section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="philosophy-container-{{ section.id }}">
      
      <!-- Left Column: Content & 4 Pillars -->
      <div class="philosophy-left">
        <div class="philosophy-content-grid">
          
          <!-- Left Text & CTA -->
          <div class="philosophy-text-col">
            {% if section.settings.title != blank %}
              <h2 class="philosophy-title">
                {{ section.settings.title }}
              </h2>
            {% endif %}

            {% if section.settings.description != blank %}
              <p class="philosophy-desc">
                {{ section.settings.description }}
              </p>
            {% endif %}

            {% if section.settings.button_label != blank %}
              <a href="{{ section.settings.button_link | default: '#' }}" class="philosophy-btn">
                {{ section.settings.button_label }}
              </a>
            {% endif %}
          </div>

          <!-- Right 4 Pillars Grid -->
          <div class="philosophy-pillars-col">
            <div class="philosophy-pillars-grid">
              
              <!-- Pillar 1: FOCUS -->
              <div class="philosophy-pillar-item">
                <div class="philosophy-pillar-icon">
                  <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="9"/>
                    <circle cx="12" cy="12" r="4"/>
                    <line x1="12" y1="1" x2="12" y2="5"/>
                    <line x1="12" y1="19" x2="12" y2="23"/>
                    <line x1="1" y1="12" x2="5" y2="12"/>
                    <line x1="19" y1="12" x2="23" y2="12"/>
                  </svg>
                </div>
                <div class="philosophy-pillar-text">
                  <span class="philosophy-pillar-heading">{{ section.settings.pillar1_title | default: 'FOCUS' }}</span>
                  <span class="philosophy-pillar-sub">{{ section.settings.pillar1_sub | default: 'Master the basics.' }}</span>
                </div>
              </div>

              <!-- Pillar 2: OVERLOAD -->
              <div class="philosophy-pillar-item">
                <div class="philosophy-pillar-icon">
                  <svg viewBox="0 0 24 24">
                    <path d="M6 5v14M18 5v14M2 9h4M18 9h4M2 15h4M18 15h4M6 12h12"/>
                  </svg>
                </div>
                <div class="philosophy-pillar-text">
                  <span class="philosophy-pillar-heading">{{ section.settings.pillar2_title | default: 'OVERLOAD' }}</span>
                  <span class="philosophy-pillar-sub">{{ section.settings.pillar2_sub | default: 'Progress with purpose.' }}</span>
                </div>
              </div>

              <!-- Pillar 3: INTENSITY -->
              <div class="philosophy-pillar-item">
                <div class="philosophy-pillar-icon">
                  <svg viewBox="0 0 24 24">
                    <path d="M12 2v20M17 15l-5 5-5-5"/>
                  </svg>
                </div>
                <div class="philosophy-pillar-text">
                  <span class="philosophy-pillar-heading">{{ section.settings.pillar3_title | default: 'INTENSITY' }}</span>
                  <span class="philosophy-pillar-sub">{{ section.settings.pillar3_sub | default: 'Push what matters.' }}</span>
                </div>
              </div>

              <!-- Pillar 4: BALANCE -->
              <div class="philosophy-pillar-item">
                <div class="philosophy-pillar-icon">
                  <svg viewBox="0 0 24 24">
                    <path d="M12 3l9 5v8l-9 5-9-5V8z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                </div>
                <div class="philosophy-pillar-text">
                  <span class="philosophy-pillar-heading">{{ section.settings.pillar4_title | default: 'BALANCE' }}</span>
                  <span class="philosophy-pillar-sub">{{ section.settings.pillar4_sub | default: 'Train body. Live life.' }}</span>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>

      <!-- Right Column: Athlete Quote & Media Background (Image or Video) -->
      {% assign bg_image_url = 'fawwaz_alli_philosophy_bg.png' | asset_url %}
      {% if section.settings.right_image != blank %}
        {% assign bg_image_url = section.settings.right_image | image_url: width: 1000 %}
      {% endif %}

      <div class="philosophy-right philosophy-right-{{ section.id }}" {% if section.settings.right_video == blank and section.settings.right_video_url == blank %}style="background-image: url('{{ bg_image_url }}');"{% endif %}>
        {% if section.settings.right_video != blank %}
          <div class="philosophy-video-bg philosophy-video-bg-{{ section.id }}">
            {{ section.settings.right_video | video_tag: autoplay: section.settings.video_autoplay, loop: section.settings.video_loop, muted: true, controls: section.settings.video_controls, playsinline: true }}
          </div>
        {% elsif section.settings.right_video_url != blank %}
          <div class="philosophy-video-bg philosophy-video-bg-{{ section.id }}">
            {% liquid
              assign yt_autoplay = 0
              if section.settings.video_autoplay
                assign yt_autoplay = 1
              endif
              assign yt_loop = 0
              if section.settings.video_loop
                assign yt_loop = 1
              endif
              assign yt_controls = 0
              if section.settings.video_controls
                assign yt_controls = 1
              endif
            %}
            {% if section.settings.right_video_url.type == 'youtube' %}
              <iframe src="https://www.youtube.com/embed/{{ section.settings.right_video_url.id }}?autoplay={{ yt_autoplay }}&mute=1&loop={{ yt_loop }}&playlist={{ section.settings.right_video_url.id }}&controls={{ yt_controls }}&showinfo=0&autohide=1" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
            {% elsif section.settings.right_video_url.type == 'vimeo' %}
              <iframe src="https://player.vimeo.com/video/{{ section.settings.right_video_url.id }}?autoplay={{ yt_autoplay }}&muted=1&loop={{ yt_loop }}&background={% if yt_controls == 1 %}0{% else %}1{% endif %}" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
            {% endif %}
          </div>
        {% endif %}

        <div class="philosophy-right-overlay"></div>
        <div class="philosophy-quote-wrapper">
          {% if section.settings.quote_text != blank %}
            <h3 class="philosophy-quote-text">
              "{{ section.settings.quote_text }}"
            </h3>
          {% endif %}

          {% if section.settings.quote_author != blank %}
            <p class="philosophy-quote-author">
              {{ section.settings.quote_author }}
            </p>
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Philosophy Banner",
  "tag": "section",
  "class": "section section-philosophy-banner",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "THE POWER BALANCE PHILOSOPHY",
      "label": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "default": "It's not about more workouts. It's about the right workouts. Power Balance teaches you how to train with purpose, focus on what matters, and progress in strength, muscle, and performance while saving time.",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "LEARN MORE",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Pillars Settings"
    },
    {
      "type": "text",
      "id": "pillar1_title",
      "default": "FOCUS",
      "label": "Pillar 1 Title"
    },
    {
      "type": "text",
      "id": "pillar1_sub",
      "default": "Master the basics.",
      "label": "Pillar 1 Subtitle"
    },
    {
      "type": "text",
      "id": "pillar2_title",
      "default": "OVERLOAD",
      "label": "Pillar 2 Title"
    },
    {
      "type": "text",
      "id": "pillar2_sub",
      "default": "Progress with purpose.",
      "label": "Pillar 2 Subtitle"
    },
    {
      "type": "text",
      "id": "pillar3_title",
      "default": "INTENSITY",
      "label": "Pillar 3 Title"
    },
    {
      "type": "text",
      "id": "pillar3_sub",
      "default": "Push what matters.",
      "label": "Pillar 3 Subtitle"
    },
    {
      "type": "text",
      "id": "pillar4_title",
      "default": "BALANCE",
      "label": "Pillar 4 Title"
    },
    {
      "type": "text",
      "id": "pillar4_sub",
      "default": "Train body. Live life.",
      "label": "Pillar 4 Subtitle"
    },
    {
      "type": "header",
      "content": "Right Quote & Media (Image or Video)"
    },
    {
      "type": "range",
      "id": "desktop_section_height",
      "min": 400,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Overall Section Height (Desktop)",
      "default": 540
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Background Image"
    },
    {
      "type": "video",
      "id": "right_video",
      "label": "Right Background Video (Uploaded Video)"
    },
    {
      "type": "video_url",
      "id": "right_video_url",
      "label": "Right Video URL (YouTube / Vimeo)",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Enable Video Autoplay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "Enable Infinite Loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_controls",
      "label": "Show Video Controls",
      "default": false
    },
    {
      "type": "select",
      "id": "desktop_media_ratio",
      "label": "Desktop Video / Image Aspect Ratio",
      "default": "full",
      "options": [
        { "value": "full", "label": "Full Height (Match Left Content)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (4:5)" },
