{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&display=swap');

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .philosophy-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#0d0d0d' }};
    color: #ffffff;
  }

  .philosophy-container-{{ section.id }} {
    background: #000000;
    border: 1px solid rgba(180, 137, 64, 0.25);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 12px 36px -4px rgba(180, 137, 64, 0.15), 0 0 20px rgba(0, 0, 0, 0.5);
    display: grid;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 990px) {
    .philosophy-container-{{ section.id }} {
      grid-template-columns: 1.35fr 0.65fr;
    }
  }

  /* Left Content */
  .philosophy-left {
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media screen and (min-width: 750px) {
    .philosophy-left {
      padding: 4rem 3.5rem;
    }
  }

  .philosophy-content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .philosophy-content-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 3.5rem;
    }
  }

  .philosophy-title {
    font-size: 3.2rem;
    font-weight: 800;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.15;
    margin: 0 0 1.4rem 0;
  }

  .philosophy-desc {
    font-size: 1.8rem;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.6;
    margin: 0 0 2.5rem 0;
  }

  .philosophy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #B48940;
    color: #ffffff !important;
    font-weight: 800;
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 1.3rem 3.2rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.3s ease, box-shadow 0.3s ease;
    align-self: flex-start;
  }

  .philosophy-btn:hover {
    background: #cba052;
    box-shadow: 0 4px 18px rgba(180, 137, 64, 0.45);
    color: #ffffff !important;
  }

  /* 4 Pillars Grid */
  .philosophy-pillars-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.4rem 2rem;
  }

  .philosophy-pillar-item {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .philosophy-pillar-icon {
    width: 50px;
    height: 50px;
    min-width: 50px;
    border-radius: 50%;
    background: rgba(180, 137, 64, 0.12);
    border: 1px solid rgba(180, 137, 64, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .philosophy-pillar-icon svg {
    width: 25px;
    height: 25px;
    fill: none;
    stroke: #B48940;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .philosophy-pillar-text {
    display: flex;
    flex-direction: column;
  }

  .philosophy-pillar-heading {
    font-size: 1.65rem;
    font-weight: 800;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 3px 0;
  }

  .philosophy-pillar-sub {
    font-size: 1.35rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    line-height: 1.3;
  }

  /* Right Quote & Image Banner */
  .philosophy-right {
    position: relative;
    min-height: 380px;
    background-size: cover;
    background-position: center top;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 3rem 2.5rem;
    border-left: 1px solid rgba(180, 137, 64, 0.2);
  }

  .philosophy-right-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.85) 100%);
    z-index: 1;
  }

  .philosophy-quote-wrapper {
    position: relative;
    z-index: 2;
  }

  .philosophy-quote-text {
    font-size: 2.5rem;
    font-weight: 800;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.3;
    margin: 0 0 1.2rem 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
  }

  .philosophy-quote-author {
    font-family: 'Caveat', cursive, sans-serif;
    font-size: 4.2rem;
    color: #B48940;
    font-weight: 700;
    margin: 0;
    letter-spacing: 0.02em;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
    transform: rotate(-3deg);
    display: inline-block;
  }

  @media screen and (max-width: 989px) {
    .philosophy-title {
      font-size: 2.4rem;
    }
    .philosophy-desc {
      font-size: 1.55rem;
    }
    .philosophy-btn {
      font-size: 1.35rem;
      padding: 1.1rem 2.5rem;
    }
    .philosophy-pillar-heading {
      font-size: 1.45rem;
    }
    .philosophy-pillar-sub {
      font-size: 1.25rem;
    }
    .philosophy-quote-text {
      font-size: 2.0rem;
    }
    .philosophy-quote-author {
      font-size: 3.4rem;
    }
    .philosophy-right {
      min-height: 320px;
      border-left: none;
      border-top: 1px solid rgba(180, 137, 64, 0.2);
    }
  }

  @media screen and (max-width: 550px) {
    .philosophy-pillars-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
{%- endstyle -%}

<div class="philosophy-section-{{ section.id }} color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="philosophy-container-{{ section.id }}">
      
      <!-- Left Column: Content & 4 Pillars -->
      <div class="philosophy-left">
        <div class="philosophy-content-grid">
          
          <!-- Left Text & CTA -->
          <div class="philosophy-text-col">
            {% if section.settings.title != blank %}
              <h2 class="philosophy-title">
                {{ section.settings.title }}
              </h2>
            {% endif %}

            {% if section.settings.description != blank %}
              <p class="philosophy-desc">
                {{ section.settings.description }}
              </p>
            {% endif %}

            {% if section.settings.button_label != blank %}
              <a href="{{ section.settings.button_link | default: '#' }}" class="philosophy-btn">
                {{ section.settings.button_label }}
              </a>
            {% endif %}
          </div>

          <!-- Right 4 Pillars Grid -->
          <div class="philosophy-pillars-col">
            <div class="philosophy-pillars-grid">
              
              <!-- Pillar 1: FOCUS -->
              <div class="philosophy-pillar-item">
                <div class="philosophy-pillar-icon">
                  <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="9"/>
                    <circle cx="12" cy="12" r="4"/>
                    <line x1="12" y1="1" x2="12" y2="5"/>
                    <line x1="12" y1="19" x2="12" y2="23"/>
                    <line x1="1" y1="12" x2="5" y2="12"/>
                    <line x1="19" y1="12" x2="23" y2="12"/>
                  </svg>
                </div>
                <div class="philosophy-pillar-text">
                  <span class="philosophy-pillar-heading">{{ section.settings.pillar1_title | default: 'FOCUS' }}</span>
                  <span class="philosophy-pillar-sub">{{ section.settings.pillar1_sub | default: 'Master the basics.' }}</span>
                </div>
              </div>

              <!-- Pillar 2: OVERLOAD -->
              <div class="philosophy-pillar-item">
                <div class="philosophy-pillar-icon">
                  <svg viewBox="0 0 24 24">
                    <path d="M6 5v14M18 5v14M2 9h4M18 9h4M2 15h4M18 15h4M6 12h12"/>
                  </svg>
                </div>
                <div class="philosophy-pillar-text">
                  <span class="philosophy-pillar-heading">{{ section.settings.pillar2_title | default: 'OVERLOAD' }}</span>
                  <span class="philosophy-pillar-sub">{{ section.settings.pillar2_sub | default: 'Progress with purpose.' }}</span>
                </div>
              </div>

              <!-- Pillar 3: INTENSITY -->
              <div class="philosophy-pillar-item">
                <div class="philosophy-pillar-icon">
                  <svg viewBox="0 0 24 24">
                    <path d="M12 2v20M17 15l-5 5-5-5"/>
                  </svg>
                </div>
                <div class="philosophy-pillar-text">
                  <span class="philosophy-pillar-heading">{{ section.settings.pillar3_title | default: 'INTENSITY' }}</span>
                  <span class="philosophy-pillar-sub">{{ section.settings.pillar3_sub | default: 'Push what matters.' }}</span>
                </div>
              </div>

              <!-- Pillar 4: BALANCE -->
              <div class="philosophy-pillar-item">
                <div class="philosophy-pillar-icon">
                  <svg viewBox="0 0 24 24">
                    <path d="M12 3l9 5v8l-9 5-9-5V8z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                </div>
                <div class="philosophy-pillar-text">
                  <span class="philosophy-pillar-heading">{{ section.settings.pillar4_title | default: 'BALANCE' }}</span>
                  <span class="philosophy-pillar-sub">{{ section.settings.pillar4_sub | default: 'Train body. Live life.' }}</span>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>

      <!-- Right Column: Athlete Quote & Generated Image Background -->
      {% assign bg_image_url = 'fawwaz_alli_philosophy_bg.png' | asset_url %}
      {% if section.settings.right_image != blank %}
        {% assign bg_image_url = section.settings.right_image | image_url: width: 1000 %}
      {% endif %}

      <div class="philosophy-right" style="background-image: url('{{ bg_image_url }}');">
        <div class="philosophy-right-overlay"></div>
        <div class="philosophy-quote-wrapper">
          {% if section.settings.quote_text != blank %}
            <h3 class="philosophy-quote-text">
              "{{ section.settings.quote_text }}"
            </h3>
          {% endif %}

          {% if section.settings.quote_author != blank %}
            <p class="philosophy-quote-author">
              {{ section.settings.quote_author }}
            </p>
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Philosophy Banner",
  "tag": "section",
  "class": "section section-philosophy-banner",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "THE POWER BALANCE PHILOSOPHY",
      "label": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "default": "It's not about more workouts. It's about the right workouts. Power Balance teaches you how to train with purpose, focus on what matters, and progress in strength, muscle, and performance while saving time.",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "LEARN MORE",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Pillars Settings"
    },
    {
      "type": "text",
      "id": "pillar1_title",
      "default": "FOCUS",
      "label": "Pillar 1 Title"
    },
    {
      "type": "text",
      "id": "pillar1_sub",
      "default": "Master the basics.",
      "label": "Pillar 1 Subtitle"
    },
    {
      "type": "text",
      "id": "pillar2_title",
      "default": "OVERLOAD",
      "label": "Pillar 2 Title"
    },
    {
      "type": "text",
      "id": "pillar2_sub",
      "default": "Progress with purpose.",
      "label": "Pillar 2 Subtitle"
    },
    {
      "type": "text",
      "id": "pillar3_title",
      "default": "INTENSITY",
      "label": "Pillar 3 Title"
    },
    {
      "type": "text",
      "id": "pillar3_sub",
      "default": "Push what matters.",
      "label": "Pillar 3 Subtitle"
    },
    {
      "type": "text",
      "id": "pillar4_title",
      "default": "BALANCE",
      "label": "Pillar 4 Title"
    },
    {
      "type": "text",
      "id": "pillar4_sub",
      "default": "Train body. Live life.",
      "label": "Pillar 4 Subtitle"
    },
    {
      "type": "header",
      "content": "Right Quote & Image"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Background Image"
    },
    {
      "type": "inline_richtext",
      "id": "quote_text",
      "default": "PERFECT FORM. PROGRESSIVE OVERLOAD. REAL RESULTS.",
      "label": "Quote Text"
    },
    {
      "type": "text",
      "id": "quote_author",
      "default": "Fawwaz Alli",
      "label": "Author Signature"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Philosophy Banner"
    }
  ]
}
{% endschema %}
