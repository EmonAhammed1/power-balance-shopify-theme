{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .progression-section-{{ section.id }} {
    background-color: #000000;
    color: #ffffff;
  }

  .progression-container {
    max-width: 1080px;
    margin: 0 auto;
  }

  .progression-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3rem auto;
  }

  .progression-title {
    font-size: 3.2rem;
    font-weight: 800;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 1rem;
  }

  .progression-subtitle {
    font-size: 1.7rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.6;
  }

  .progression-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  /* Metric Dashboard Card */
  .progression-card {
    position: relative;
    background: #0d0e12;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2rem;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .progression-card:hover {
    border-color: rgba(180, 137, 64, 0.4);
    box-shadow: 0 14px 40px rgba(180, 137, 64, 0.15), 0 0 20px rgba(0, 0, 0, 0.8);
    transform: translateY(-3px);
  }

  .progression-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.5rem;
  }

  .progression-card__title {
    font-size: 1.8rem;
    font-weight: 700;
    color: #8f96a3;
    letter-spacing: 0.02em;
    margin: 0;
  }

  /* Graph Visualization Area */
  .progression-card__visual {
    position: relative;
    width: 100%;
    height: 140px;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .progression-svg-chart {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* Stats Footer Inside Card */
  .progression-card__stats {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }

  .progression-card__badge-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.2rem;
    color: #8f96a3;
    margin-bottom: 0.4rem;
  }

  .progression-card__badge {
    font-size: 1.2rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  .progression-card__badge--positive {
    color: #22c55e;
    background: rgba(34, 197, 94, 0.12);
  }

  .progression-card__badge--negative {
    color: #ef4444;
    background: rgba(239, 68, 68, 0.12);
  }

  .progression-card__value {
    font-size: 4.2rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  /* Circular Ring Progress Specific */
  .circular-progress-wrap {
    position: relative;
    width: 130px;
    height: 130px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .circular-progress-val {
    position: absolute;
    font-size: 3rem;
    font-weight: 800;
    color: #ffffff;
  }

  /* Corner Accent Triangles */
  .progression-corner-accent {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 22px 0 0 22px;
    border-color: transparent transparent transparent var(--accent-color, #22c55e);
  }

  /* 📱 Mobile Responsiveness */
  @media screen and (max-width: 749px) {
    .progression-title {
      font-size: 2.2rem;
    }

    .progression-subtitle {
      font-size: 1.35rem;
    }

    .progression-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .progression-card {
      padding: 1.2rem 1rem;
      border-radius: 12px;
    }

    .progression-card__title {
      font-size: 1.35rem;
    }

    .progression-card__value {
      font-size: 2.8rem;
    }

    .circular-progress-wrap {
      width: 100px;
      height: 100px;
    }

    .circular-progress-val {
      font-size: 2.2rem;
    }
  }

  @media screen and (max-width: 480px) {
    .progression-grid {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<div class="progression-section-{{ section.id }} section-{{ section.id }}-padding">
  <div class="page-width progression-container">
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="progression-header">
        {%- if section.settings.title != blank -%}
          <h2 class="progression-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <div class="progression-subtitle">{{ section.settings.subtitle }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="progression-grid">
      <!-- Card 1: Line Area Graph (Strength & Load Gains) -->
      <div class="progression-card">
        <div class="progression-card__header">
          <h3 class="progression-card__title">{{ section.settings.card1_title }}</h3>
        </div>

        <div class="progression-card__visual">
          <svg class="progression-svg-chart" viewBox="0 0 300 120" preserveAspectRatio="none">
            <defs>
              <linearGradient id="chartGrad1" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#22c55e" stop-opacity="0.5" />
                <stop offset="100%" stop-color="#06b6d4" stop-opacity="0.0" />
              </linearGradient>
              <linearGradient id="lineGrad1" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#22c55e" />
                <stop offset="100%" stop-color="#06b6d4" />
              </linearGradient>
              <pattern id="gridLines1" width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(255, 255, 255, 0.05)" stroke-width="1" />
              </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#gridLines1)" />
            <path d="M 0 80 Q 40 10, 80 50 T 160 60 T 240 90 T 300 40 L 300 120 L 0 120 Z" fill="url(#chartGrad1)" />
            <path d="M 0 80 Q 40 10, 80 50 T 160 60 T 240 90 T 300 40" fill="none" stroke="url(#lineGrad1)" stroke-width="4.5" stroke-linecap="round" />
          </svg>
        </div>

        <div class="progression-card__stats">
          <div class="progression-card__badge-wrap">
            <span>{{ section.settings.card1_subtext }}</span>
            <span class="progression-card__badge progression-card__badge--positive">{{ section.settings.card1_badge }}</span>
          </div>
          <div class="progression-card__value">{{ section.settings.card1_value }}</div>
        </div>

        <div class="progression-corner-accent" style="--accent-color: #22c55e;"></div>
      </div>

      <!-- Card 2: Wave Graph (Hypertrophy & Activation) -->
      <div class="progression-card">
        <div class="progression-card__header">
          <h3 class="progression-card__title">{{ section.settings.card2_title }}</h3>
        </div>

        <div class="progression-card__visual">
          <svg class="progression-svg-chart" viewBox="0 0 300 120" preserveAspectRatio="none">
            <defs>
              <linearGradient id="chartGrad2" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#a855f7" stop-opacity="0.5" />
                <stop offset="100%" stop-color="#ec4899" stop-opacity="0.0" />
              </linearGradient>
              <linearGradient id="lineGrad2" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#a855f7" />
                <stop offset="100%" stop-color="#06b6d4" />
              </linearGradient>
            </defs>
            <rect width="100%" height="100%" fill="url(#gridLines1)" />
            <path d="M 0 40 Q 50 80, 100 20 T 200 40 T 300 15 L 300 120 L 0 120 Z" fill="url(#chartGrad2)" />
            <path d="M 0 40 Q 50 80, 100 20 T 200 40 T 300 15" fill="none" stroke="url(#lineGrad2)" stroke-width="4.5" stroke-linecap="round" />
          </svg>
        </div>

        <div class="progression-card__stats">
          <div class="progression-card__badge-wrap">
            <span>{{ section.settings.card2_subtext }}</span>
            <span class="progression-card__badge progression-card__badge--negative">{{ section.settings.card2_badge }}</span>
          </div>
          <div class="progression-card__value">{{ section.settings.card2_value }}</div>
        </div>

        <div class="progression-corner-accent" style="--accent-color: #ef4444;"></div>
      </div>

      <!-- Card 3: Circular Ring (Form & Movement Mastery) -->
      <div class="progression-card">
        <div class="progression-card__header">
          <h3 class="progression-card__title">{{ section.settings.card3_title }}</h3>
        </div>

        <div class="progression-card__visual">
          <div class="circular-progress-wrap">
            <svg width="120" height="120" viewBox="0 0 120 120">
              <defs>
                <linearGradient id="circleGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#10b981" />
                  <stop offset="100%" stop-color="#06b6d4" />
                </linearGradient>
              </defs>
              <circle cx="60" cy="60" r="50" fill="none" stroke="rgba(255, 255, 255, 0.08)" stroke-width="10" />
              <!-- 76% Progress stroke-dasharray = 314, stroke-dashoffset = 75 -->
              <circle cx="60" cy="60" r="50" fill="none" stroke="url(#circleGrad1)" stroke-width="10" stroke-linecap="round" stroke-dasharray="314" stroke-dashoffset="75" transform="rotate(-90 60 60)" />
            </svg>
            <div class="circular-progress-val">{{ section.settings.card3_value }}</div>
          </div>
        </div>

        <div class="progression-corner-accent" style="--accent-color: #06b6d4;"></div>
      </div>

      <!-- Card 4: Circular Ring (Neural Recovery Rate) -->
      <div class="progression-card">
        <div class="progression-card__header">
          <h3 class="progression-card__title">{{ section.settings.card4_title }}</h3>
        </div>

        <div class="progression-card__visual">
          <div class="circular-progress-wrap">
            <svg width="120" height="120" viewBox="0 0 120 120">
              <defs>
                <linearGradient id="circleGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#a855f7" />
                  <stop offset="100%" stop-color="#3b82f6" />
                </linearGradient>
              </defs>
              <circle cx="60" cy="60" r="50" fill="none" stroke="rgba(255, 255, 255, 0.08)" stroke-width="10" />
              <!-- 64% Progress stroke-dasharray = 314, stroke-dashoffset = 113 -->
              <circle cx="60" cy="60" r="50" fill="none" stroke="url(#circleGrad2)" stroke-width="10" stroke-linecap="round" stroke-dasharray="314" stroke-dashoffset="113" transform="rotate(-90 60 60)" />
            </svg>
            <div class="circular-progress-val">{{ section.settings.card4_value }}</div>
          </div>
        </div>

        <div class="progression-corner-accent" style="--accent-color: #a855f7;"></div>
      </div>
    </div>
  </div>
</div>

