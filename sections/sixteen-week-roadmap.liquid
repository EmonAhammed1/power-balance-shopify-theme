{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .roadmap-section-{{ section.id }} {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.90) 0%, rgba(8, 9, 13, 0.94) 100%), url('{{ "roadmap_bg.png" | asset_url }}') center center / cover no-repeat;
    color: #ffffff;
    overflow: hidden;
    position: relative;
  }

  .roadmap-container {
    max-width: 1420px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .roadmap-header {
    text-align: center;
    max-width: 950px;
    margin: 0 auto 3.5rem auto;
  }

  .roadmap-title {
    font-size: 4.2rem;
    font-weight: 900;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.15;
    margin-bottom: 0.8rem;
  }

  .roadmap-title span {
    color: #b48940;
    display: block;
    font-size: 4.5rem;
    text-shadow: 0 0 20px rgba(180, 137, 64, 0.4);
  }

  .roadmap-subtitle {
    font-size: 1.95rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.45;
  }

  /* Timeline Top Track Line */
  .roadmap-timeline-wrapper {
    position: relative;
    margin-bottom: 2.5rem;
  }

  .roadmap-timeline-track {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.4rem;
    position: relative;
    margin-bottom: 1.5rem;
  }

  .roadmap-timeline-track::before {
    content: '';
    position: absolute;
    bottom: 10px;
    left: 8%;
    right: 8%;
    height: 3px;
    background: linear-gradient(90deg, #b48940 0%, #f59e0b 50%, #b48940 100%);
    z-index: 1;
    box-shadow: 0 0 12px rgba(180, 137, 64, 0.7);
  }

  .roadmap-timeline-node {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    cursor: pointer;
  }

  .roadmap-node-label {
    font-size: 1.65rem;
    font-weight: 900;
    color: #b48940;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    word-spacing: 0.1em;
    background: #08090d;
    padding: 0.2rem 0.8rem;
    border-radius: 6px;
    transition: color 0.3s ease;
  }

  .roadmap-node-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #08090d;
    border: 4px solid #b48940;
    box-shadow: 0 0 14px rgba(180, 137, 64, 0.9);
    position: relative;
    z-index: 3;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  /* 5 Pillars Cards Grid */
  .roadmap-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.4rem;
    margin-bottom: 2rem;
  }

  .roadmap-card {
    background: rgba(14, 15, 20, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(180, 137, 64, 0.35);
    border-radius: 18px;
    padding: 2rem 1.6rem 1.6rem 1.6rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.7);
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .roadmap-card:hover {
    border-color: #b48940;
    transform: translateY(-5px);
    box-shadow: 0 18px 50px rgba(180, 137, 64, 0.28);
  }

  .roadmap-card__icon-wrap {
    width: 62px;
    height: 62px;
    border-radius: 50%;
    border: 2px solid #b48940;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.4rem auto;
    background: rgba(180, 137, 64, 0.15);
    color: #b48940;
    box-shadow: 0 0 15px rgba(180, 137, 64, 0.3);
  }

  .roadmap-card__icon-wrap svg {
    width: 30px;
    height: 30px;
    fill: currentColor;
  }

  .roadmap-card__title {
    font-size: 1.75rem !important;
    font-weight: 800 !important;
    font-family: inherit !important;
    color: #ffffff !important;
    text-transform: uppercase !important;
    text-align: center !important;
    letter-spacing: 0.05em !important;
    word-spacing: 0.15em !important;
    line-height: 1.35 !important;
    margin-bottom: 1.4rem !important;
    min-height: 4.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .roadmap-card__list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.8rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .roadmap-card__item {
    font-size: 1.4rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.95);
    line-height: 1.4;
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
  }

  .roadmap-card__check {
    color: #22c55e;
    font-size: 1.45rem;
    font-weight: 900;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .roadmap-card__media {
    margin-top: auto;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    min-height: 130px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .roadmap-card__media img {
    width: 100%;
    height: 130px;
    object-fit: cover;
    display: block;
  }

  /* Ring Progress Meter Inside Pillar 4 */
  .roadmap-ring-meter {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem 0;
  }

  .roadmap-ring-wrap {
    position: relative;
    width: 100px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .roadmap-ring-val {
    position: absolute;
    font-size: 2.3rem;
    font-weight: 900;
    color: #ffffff;
  }

  .roadmap-ring-label {
    font-size: 1.1rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.85);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.6rem;
    text-align: center;
  }

  /* CTA Button in Pillar 5 */
  .roadmap-cta-btn {
    display: block;
    width: 100%;
    background: linear-gradient(135deg, #d4af37 0%, #b48940 100%);
    color: #000000 !important;
    font-size: 1.35rem;
    font-weight: 900;
    text-transform: uppercase;
    text-align: center;
    padding: 1.2rem 0.8rem;
    border-radius: 12px;
    text-decoration: none;
    letter-spacing: 0.03em;
    box-shadow: 0 8px 24px rgba(180, 137, 64, 0.5);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    margin-top: 1rem;
  }

  .roadmap-cta-btn:hover {
    transform: scale(1.03);
    box-shadow: 0 10px 30px rgba(180, 137, 64, 0.7);
  }

  /* Bottom Benefits Bar (WHAT YOU'LL BUILD OVER 16 WEEKS) */
  .roadmap-benefits-bar {
    background: rgba(12, 13, 18, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(180, 137, 64, 0.35);
    border-radius: 18px;
    padding: 2.5rem 2rem;
    margin-top: 3rem;
    margin-bottom: 2rem;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6);
  }

  .roadmap-benefits-title {
    font-size: 1.7rem;
    font-weight: 900;
    color: #b48940;
    text-transform: uppercase;
    text-align: center;
    letter-spacing: 0.12em;
    margin-bottom: 2.2rem;
  }

  .roadmap-benefits-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.2rem;
    text-align: center;
  }

  .roadmap-benefit-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    padding: 0 0.5rem;
    border-right: 1px solid rgba(255, 255, 255, 0.12);
  }

  .roadmap-benefit-col:last-child {
    border-right: none;
  }

  .roadmap-benefit-icon {
    width: 42px;
    height: 42px;
    color: #b48940;
  }

  .roadmap-benefit-icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .roadmap-benefit-name {
    font-size: 1.5rem;
    font-weight: 900;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .roadmap-benefit-desc {
    font-size: 1.3rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.4;
  }

  /* Disclaimer Footer Note */
  .roadmap-disclaimer {
    background: rgba(8, 9, 13, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    padding: 1.4rem 2rem;
    text-align: center;
    font-size: 1.35rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .roadmap-disclaimer-icon {
    color: #b48940;
    flex-shrink: 0;
  }

  /* 📱 MOBILE RESPONSIVE SLIDER */
  @media screen and (max-width: 768px) {
    .roadmap-timeline-track {
      display: flex !important;
      overflow-x: auto !important;
      gap: 1rem !important;
      padding-bottom: 0.8rem !important;
      scrollbar-width: none !important;
      justify-content: flex-start !important;
      -webkit-overflow-scrolling: touch !important;
      margin-bottom: 1.8rem !important;
      position: relative !important;
    }
    .roadmap-timeline-track::-webkit-scrollbar {
      display: none !important;
    }
    .roadmap-timeline-node {
      flex: 0 0 auto !important;
      min-width: 85px !important;
      gap: 0.7rem !important;
    }
    .roadmap-node-label {
      white-space: nowrap !important;
      font-size: 1.3rem !important;
      letter-spacing: 0.05em !important;
      word-spacing: normal !important;
      padding: 0.2rem 0.6rem !important;
    }
    .roadmap-node-dot {
      width: 18px !important;
      height: 18px !important;
      border-width: 3px !important;
    }
    .roadmap-timeline-track::before {
      bottom: 9px !important;
      left: 15px !important;
      right: 15px !important;
    }

    .roadmap-grid {
      display: flex !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory !important;
      scroll-behavior: smooth !important;
      gap: 1.2rem !important;
      padding-bottom: 1rem !important;
      -webkit-overflow-scrolling: touch !important;
      scrollbar-width: none !important;
    }
    
    .roadmap-grid::-webkit-scrollbar {
      display: none !important;
    }
    
    .roadmap-card {
      min-width: 88% !important;
      max-width: 88% !important;
      flex: 0 0 88% !important;
      scroll-snap-align: center !important;
      padding: 1.4rem 1.2rem 1.2rem 1.2rem !important;
    }

    .roadmap-card__icon-wrap {
      margin: 0 auto 1rem auto !important;
      width: 52px !important;
      height: 52px !important;
    }

    .roadmap-card__icon-wrap svg {
      width: 26px !important;
      height: 26px !important;
    }

    .roadmap-card__title {
      font-size: 1.55rem !important;
      min-height: 3.6rem !important;
      margin-bottom: 1rem !important;
      word-spacing: 0.12em !important;
    }

    .roadmap-mobile-controls {
      display: flex !important;
      align-items: center;
      justify-content: space-between;
      margin-top: 1rem;
      padding: 0 0.5rem;
    }

    .roadmap-slider-arrow {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: rgba(180, 137, 64, 0.18);
      border: 1.5px solid #b48940;
      color: #b48940;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
      transition: background 0.2s ease, transform 0.2s ease;
    }

    .roadmap-slider-arrow svg {
      width: 20px;
      height: 20px;
      fill: currentColor;
    }

    .roadmap-slider-arrow:active {
      transform: scale(0.92);
      background: #b48940;
      color: #000000;
    }

    .roadmap-slider-dots {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .roadmap-slider-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.25);
      border: 1px solid rgba(180, 137, 64, 0.5);
      transition: all 0.3s ease;
      cursor: pointer;
    }

    .roadmap-slider-dot.active {
      width: 24px;
      border-radius: 12px;
      background: #b48940;
      box-shadow: 0 0 12px rgba(180, 137, 64, 0.9);
    }
  }

  @media screen and (min-width: 769px) {
    .roadmap-mobile-controls {
      display: none !important;
    }
  }

  @media screen and (max-width: 640px) {
    .roadmap-title {
      font-size: 2.8rem;
    }

    .roadmap-title span {
      font-size: 3.0rem;
    }

    .roadmap-subtitle {
      font-size: 1.5rem;
    }

    .roadmap-benefits-grid {
      grid-template-columns: 1fr;
    }

    .roadmap-disclaimer {
      flex-direction: column;
      text-align: center;
    }
  }
{%- endstyle -%}

<div class="roadmap-section-{{ section.id }} section-{{ section.id }}-padding">
  <div class="page-width roadmap-container">
    <!-- Header -->
    <div class="roadmap-header">
      <h2 class="roadmap-title">
        TRACK YOUR PROGRESS
        <span>IN 16 WEEKS</span>
      </h2>
      <div class="roadmap-subtitle">
        Real progress comes from a proven system and consistent action.
      </div>
    </div>

    <!-- Timeline Track Line -->
    <div class="roadmap-timeline-wrapper">
      <div class="roadmap-timeline-track">
        <div class="roadmap-timeline-node" data-index="0">
          <span class="roadmap-node-label">WEEK 1</span>
          <div class="roadmap-node-dot"></div>
        </div>
        <div class="roadmap-timeline-node" data-index="1">
          <span class="roadmap-node-label">WEEK 4</span>
          <div class="roadmap-node-dot"></div>
        </div>
        <div class="roadmap-timeline-node" data-index="2">
          <span class="roadmap-node-label">WEEK 8</span>
          <div class="roadmap-node-dot"></div>
        </div>
        <div class="roadmap-timeline-node" data-index="3">
          <span class="roadmap-node-label">WEEK 12</span>
          <div class="roadmap-node-dot"></div>
        </div>
        <div class="roadmap-timeline-node" data-index="4">
          <span class="roadmap-node-label">WEEK 16</span>
          <div class="roadmap-node-dot"></div>
        </div>
      </div>
    </div>

    <!-- 5 Pillars Cards Grid / Mobile Slider -->
    <div class="roadmap-slider-wrapper">
      <div class="roadmap-grid">
        <!-- Pillar 1: Week 1 -->
        <div class="roadmap-card" data-index="0">
          <div>
            <div class="roadmap-card__icon-wrap">
              <!-- Dumbbell Icon -->
              <svg viewBox="0 0 24 24"><path d="M6 5v14M18 5v14M3 8v8M21 8v8M6 12h12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
            </div>
            <h3 class="roadmap-card__title">BUILD THE FOUNDATION</h3>
            <ul class="roadmap-card__list">
              <li class="roadmap-card__item"><span class="roadmap-card__check">✔</span> Learn proper exercise technique</li>
              <li class="roadmap-card__item"><span class="roadmap-card__check">✔</span> Establish training consistency</li>
              <li class="roadmap-card__item"><span class="roadmap-card__check">✔</span> Improve mobility and movement</li>
              <li class="roadmap-card__item"><span class="roadmap-card__check">✔</span> Develop healthy habits</li>
            </ul>
          </div>
          <div class="roadmap-card__media">
            <img src="{{ 'roadmap_pushup.png' | asset_url }}" alt="Build Foundation" loading="lazy" width="300" height="130">
          </div>
        </div>

        <!-- Pillar 2: Week 4 -->
        <div class="roadmap-card" data-index="1">
          <div>
            <div class="roadmap-card__icon-wrap">
              <!-- Trending Up Chart Icon -->
              <svg viewBox="0 0 24 24"><path d="M3 17l6-6 4 4 8-8M14 7h7v7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
            </div>
            <h3 class="roadmap-card__title">STRENGTH STARTS GROWING</h3>
            <ul class="roadmap-card__list">
              <li class="roadmap-card__item"><span class="roadmap-card__check">✔</span> Lift heavier with better control</li>
              <li class="roadmap-card__item"><span class="roadmap-card__check">✔</span> Notice increased energy</li>
              <li class="roadmap-card__item"><span class="roadmap-card__check">✔</span> Better workout performance</li>
              <li class="roadmap-card__item"><span class="roadmap-card__check">✔</span> Improved recovery routine</li>
            </ul>
          </div>
          <div class="roadmap-card__media">
            <svg viewBox="0 0 200 100" style="width:100%; height:110px; padding:10px;">
              <defs>
                <linearGradient id="chartG3" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%" stop-color="#b48940" />
                  <stop offset="100%" stop-color="#f59e0b" />
                </linearGradient>
              </defs>
              <path d="M 10 85 Q 40 75, 70 65 T 130 35 T 190 15" fill="none" stroke="url(#chartG3)" stroke-width="5" stroke-linecap="round"/>
              <circle cx="190" cy="15" r="6" fill="#f59e0b"/>
            </svg>
          </div>
        </div>

        <!-- Pillar 3: Week 8 -->
        <div class="roadmap-card" data-index="2">
          <div>
            <div class="roadmap-card__icon-wrap">
              <!-- Target Focus Icon -->
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" fill="none"/><circle cx="12" cy="12" r="4" fill="currentColor"/></svg>
            </div>
            <h3 class="roadmap-card__title">PERFORMANCE UPGRADE</h3>
            <ul class="roadmap-card__list">
              <li class="roadmap-card__item"><span class="roadmap-card__check">✔</span> Progressive overload kicks in</li>
              <li class="roadmap-card__item"><span class="roadmap-card__check">✔</span> Improved endurance</li>
              <li class="roadmap-card__item"><span class="roadmap-card__check">✔</span> Better muscle engagement</li>
              <li class="roadmap-card__item"><span class="roadmap-card__check">✔</span> Increased training confidence</li>
            </ul>
          </div>
          <div class="roadmap-card__media">
            <img src="{{ 'roadmap_battlerope.png' | asset_url }}" alt="Performance Upgrade" loading="lazy" width="300" height="130">
          </div>
        </div>

        <!-- Pillar 4: Week 12 -->
        <div class="roadmap-card" data-index="3">
          <div>
            <div class="roadmap-card__icon-wrap">
              <!-- Shield Star Icon -->
              <svg viewBox="0 0 24 24"><path d="M12 2L4 5v6c0 5.5 3.8 10.7 8 12 4.2-1.3 8-6.5 8-12V5l-8-3z" stroke="currentColor" stroke-width="2" fill="none"/><polygon points="12 8 13.2 10.5 16 10.9 14 12.8 14.5 15.5 12 14.2 9.5 15.5 10 12.8 8 10.9 10.8 10.5" fill="currentColor"/></svg>
            </div>
            <h3 class="roadmap-card__title">VISIBLE PROGRESS</h3>
            <ul class="roadmap-card__list">
              <li class="roadmap-card__item"><span class="roadmap-card__check">✔</span> Stronger physique</li>
              <li class="roadmap-card__item"><span class="roadmap-card__check">✔</span> Better movement quality</li>
              <li class="roadmap-card__item"><span class="roadmap-card__check">✔</span> Higher work capacity</li>
              <li class="roadmap-card__item"><span class="roadmap-card__check">✔</span> Consistent weekly routine</li>
            </ul>
          </div>
          <div class="roadmap-card__media">
            <div class="roadmap-ring-meter">
              <div class="roadmap-ring-wrap">
                <svg width="90" height="90" viewBox="0 0 100 100">
                  <circle cx="50" cy="50" r="40" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="8"/>
                  <circle cx="50" cy="50" r="40" fill="none" stroke="#b48940" stroke-width="8" stroke-dasharray="251" stroke-dashoffset="62" stroke-linecap="round" transform="rotate(-90 50 50)"/>
                </svg>
                <div class="roadmap-ring-val">75%</div>
              </div>
              <div class="roadmap-ring-label">Program Completion</div>
            </div>
          </div>
        </div>

        <!-- Pillar 5: Week 16 -->
        <div class="roadmap-card" data-index="4">
          <div>
            <div class="roadmap-card__icon-wrap">
              <!-- Trophy Icon -->
              <svg viewBox="0 0 24 24"><path d="M6 4h12v4a6 6 0 01-12 0V4zM4 6H2a3 3 0 003 3M20 6h2a3 3 0 01-3 3M12 14v4M8 20h8" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
            </div>
            <h3 class="roadmap-card__title">TRANSFORMATION COMPLETE</h3>
            <ul class="roadmap-card__list">
              <li class="roadmap-card__item"><span class="roadmap-card__check">✔</span> Complete the full program</li>
              <li class="roadmap-card__item"><span class="roadmap-card__check">✔</span> Improved strength</li>
              <li class="roadmap-card__item"><span class="roadmap-card__check">✔</span> Better fitness habits</li>
              <li class="roadmap-card__item"><span class="roadmap-card__check">✔</span> Ready for the next challenge</li>
            </ul>
          </div>
          <div>
            <div class="roadmap-card__media">
              <img src="{{ 'roadmap_flexing.png' | asset_url }}" alt="Transformation Complete" loading="lazy" width="300" height="130">
            </div>
            <a href="#SectionAtcBtn-{{ section.id }}" class="roadmap-cta-btn">START YOUR TRANSFORMATION</a>
          </div>
