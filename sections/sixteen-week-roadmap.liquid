{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .roadmap-section-{{ section.id }} {
    background-color: #000000;
    color: #ffffff;
    overflow: hidden;
  }

  .roadmap-container {
    max-width: 1320px;
    margin: 0 auto;
  }

  .roadmap-header {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 3.5rem auto;
  }

  .roadmap-title {
    font-size: 3.6rem;
    font-weight: 900;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.1;
    margin-bottom: 0.6rem;
  }

  .roadmap-title span {
    color: #b48940;
    display: block;
    font-size: 3.8rem;
  }

  .roadmap-subtitle {
    font-size: 1.7rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.5;
  }

  /* Timeline Top Track Line */
  .roadmap-timeline-wrapper {
    position: relative;
    margin-bottom: 2rem;
  }

  .roadmap-timeline-track {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    position: relative;
    margin-bottom: 1.5rem;
  }

  .roadmap-timeline-track::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 8%;
    right: 8%;
    height: 2px;
    background: linear-gradient(90deg, #b48940 0%, #d4af37 50%, #b48940 100%);
    transform: translateY(-50%);
    z-index: 1;
  }

  .roadmap-timeline-node {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }

  .roadmap-node-label {
    font-size: 1.35rem;
    font-weight: 800;
    color: #b48940;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .roadmap-node-dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #000000;
    border: 3px solid #b48940;
    box-shadow: 0 0 10px rgba(180, 137, 64, 0.8);
  }

  /* 5 Pillars Cards Grid */
  .roadmap-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.2rem;
    margin-bottom: 3rem;
  }

  .roadmap-card {
    background: rgba(18, 19, 24, 0.95);
    border: 1px solid rgba(180, 137, 64, 0.25);
    border-radius: 16px;
    padding: 1.8rem 1.4rem 1.4rem 1.4rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6);
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .roadmap-card:hover {
    border-color: #b48940;
    transform: translateY(-4px);
    box-shadow: 0 16px 45px rgba(180, 137, 64, 0.22);
  }

  .roadmap-card__icon-wrap {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    border: 2px solid #b48940;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.2rem auto;
    background: rgba(180, 137, 64, 0.1);
    color: #b48940;
  }

  .roadmap-card__icon-wrap svg {
    width: 26px;
    height: 26px;
    fill: currentColor;
  }

  .roadmap-card__title {
    font-size: 1.4rem;
    font-weight: 800;
    color: #ffffff;
    text-transform: uppercase;
    text-align: center;
    letter-spacing: 0.03em;
    line-height: 1.25;
    margin-bottom: 1.2rem;
    min-height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .roadmap-card__list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .roadmap-card__item {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.35;
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .roadmap-card__check {
    color: #22c55e;
    font-size: 1.2rem;
    font-weight: bold;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .roadmap-card__media {
    margin-top: auto;
    width: 100%;
    border-radius: 10px;
    overflow: hidden;
    position: relative;
    min-height: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.4);
  }

  .roadmap-card__media img {
    width: 100%;
    height: 110px;
    object-fit: cover;
    display: block;
  }

  /* Ring Progress Meter Inside Pillar 4 */
  .roadmap-ring-meter {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 0;
  }

  .roadmap-ring-wrap {
    position: relative;
    width: 90px;
    height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .roadmap-ring-val {
    position: absolute;
    font-size: 2rem;
    font-weight: 800;
    color: #ffffff;
  }

  .roadmap-ring-label {
    font-size: 0.95rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.4rem;
    text-align: center;
  }

  /* CTA Button in Pillar 5 */
  .roadmap-cta-btn {
    display: block;
    width: 100%;
    background: linear-gradient(135deg, #d4af37 0%, #b48940 100%);
    color: #000000 !important;
    font-size: 1.2rem;
    font-weight: 800;
    text-transform: uppercase;
    text-align: center;
    padding: 1.1rem 0.6rem;
    border-radius: 10px;
    text-decoration: none;
    letter-spacing: 0.03em;
    box-shadow: 0 6px 20px rgba(180, 137, 64, 0.4);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    margin-top: 0.8rem;
  }

  .roadmap-cta-btn:hover {
    transform: scale(1.02);
    box-shadow: 0 8px 25px rgba(180, 137, 64, 0.6);
  }

  /* Bottom Benefits Bar (WHAT YOU'LL BUILD OVER 16 WEEKS) */
  .roadmap-benefits-bar {
    background: rgba(14, 15, 20, 0.9);
    border: 1px solid rgba(180, 137, 64, 0.25);
    border-radius: 16px;
    padding: 2.2rem 1.8rem;
    margin-bottom: 1.5rem;
  }

  .roadmap-benefits-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: #b48940;
    text-transform: uppercase;
    text-align: center;
    letter-spacing: 0.12em;
    margin-bottom: 2rem;
  }

  .roadmap-benefits-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    text-align: center;
  }

  .roadmap-benefit-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 0 0.4rem;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }

  .roadmap-benefit-col:last-child {
    border-right: none;
  }

  .roadmap-benefit-icon {
    width: 36px;
    height: 36px;
    color: #b48940;
  }

  .roadmap-benefit-icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .roadmap-benefit-name {
    font-size: 1.3rem;
    font-weight: 800;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .roadmap-benefit-desc {
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.35;
  }

  /* Disclaimer Footer Note */
  .roadmap-disclaimer {
    background: rgba(10, 11, 15, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.2rem 1.8rem;
    text-align: center;
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.5;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
  }

  .roadmap-disclaimer-icon {
    color: #b48940;
    flex-shrink: 0;
  }

  /* 📱 MOBILE RESPONSIVENESS */
  @media screen and (max-width: 1024px) {
    .roadmap-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .roadmap-benefits-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem 1rem;
    }

    .roadmap-benefit-col {
      border-right: none;
    }
  }

  @media screen and (max-width: 640px) {
    .roadmap-title {
      font-size: 2.4rem;
    }

    .roadmap-title span {
      font-size: 2.6rem;
    }

    .roadmap-subtitle {
      font-size: 1.35rem;
    }

    .roadmap-timeline-track {
      display: flex;
      overflow-x: auto;
      padding-bottom: 0.8rem;
      justify-content: space-between;
    }

    .roadmap-grid {
      grid-template-columns: 1fr;
    }

    .roadmap-benefits-grid {
      grid-template-columns: 1fr;
    }

    .roadmap-disclaimer {
      flex-direction: column;
      text-align: center;
    }
  }
{%- endstyle -%}

