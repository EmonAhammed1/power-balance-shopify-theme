<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('.roadmap-section-{{ section.id }}');
    if (!section) return;

    const grid = section.querySelector('.roadmap-grid');
    const cards = section.querySelectorAll('.roadmap-card');
    const prevBtn = section.querySelector('.roadmap-arrow-prev');
    const nextBtn = section.querySelector('.roadmap-arrow-next');
    const dots = section.querySelectorAll('.roadmap-slider-dot');
    const nodes = section.querySelectorAll('.roadmap-timeline-node');

    if (!grid || cards.length === 0) return;

    let currentIndex = 0;
    let autoplayTimer = null;

    function goToSlide(index) {
      if (index < 0) index = cards.length - 1;
      if (index >= cards.length) index = 0;
      currentIndex = index;

      const card = cards[currentIndex];
      if (card && window.innerWidth <= 768) {
        const scrollLeft = card.offsetLeft - (grid.clientWidth - card.clientWidth) / 2;
        grid.scrollTo({ left: scrollLeft, behavior: 'smooth' });
      }

      // Update dots
      dots.forEach((dot, idx) => {
        dot.classList.toggle('active', idx === currentIndex);
      });

      // Update timeline nodes highlight
      nodes.forEach((node, idx) => {
        const dotElem = node.querySelector('.roadmap-node-dot');
        const labelElem = node.querySelector('.roadmap-node-label');
        if (dotElem) {
          if (idx === currentIndex) {
            dotElem.style.borderColor = '#f59e0b';
            dotElem.style.boxShadow = '0 0 16px rgba(245, 158, 11, 1)';
            if (labelElem) labelElem.style.color = '#f59e0b';
          } else {
            dotElem.style.borderColor = '#b48940';
            dotElem.style.boxShadow = '0 0 14px rgba(180, 137, 64, 0.9)';
            if (labelElem) labelElem.style.color = '#b48940';
          }
        }
      });
    }

    function startAutoplay() {
      if (window.innerWidth <= 768) {
        stopAutoplay();
        autoplayTimer = setInterval(function() {
          goToSlide(currentIndex + 1);
        }, 3500);
      }
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        stopAutoplay();
        goToSlide(currentIndex - 1);
        startAutoplay();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        stopAutoplay();
        goToSlide(currentIndex + 1);
        startAutoplay();
      });
    }

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', function() {
        stopAutoplay();
        goToSlide(idx);
        startAutoplay();
      });
    });

    nodes.forEach((node, idx) => {
      node.addEventListener('click', function() {
        stopAutoplay();
        goToSlide(idx);
        startAutoplay();
      });
    });

    grid.addEventListener('scroll', function() {
      if (window.innerWidth > 768) return;
      const scrollPos = grid.scrollLeft + grid.clientWidth / 2;
      cards.forEach((card, idx) => {
        const cardStart = card.offsetLeft;
        const cardEnd = cardStart + card.clientWidth;
        if (scrollPos >= cardStart && scrollPos <= cardEnd) {
          if (currentIndex !== idx) {
            currentIndex = idx;
            dots.forEach((d, i) => d.classList.toggle('active', i === currentIndex));
          }
        }
      });
    });

    grid.addEventListener('touchstart', stopAutoplay);
    grid.addEventListener('touchend', function() {
      setTimeout(startAutoplay, 2000);
    });

    startAutoplay();
  });
</script>

