{%- style -%}
  .contact-hero-container-{{ section.id }} {
    background-color: #000000;
    color: #ffffff;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  .contact-hero-header {
    text-align: center;
    max-width: 840px;
    margin: 0 auto 3.5rem auto;
    padding: 0 1.5rem;
  }

  .contact-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, rgba(180, 137, 64, 0.25) 0%, rgba(180, 137, 64, 0.08) 100%);
    border: 1.5px solid rgba(180, 137, 64, 0.7);
    color: #f3d38c;
    padding: 12px 28px;
    border-radius: 50px;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    box-shadow: 0 0 20px rgba(180, 137, 64, 0.25);
  }

  .contact-hero-badge svg {
    width: 22px;
    height: 22px;
    fill: #f3d38c;
  }

  .contact-hero-title {
    font-size: clamp(3.2rem, 5vw, 4.5rem);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.15;
    margin: 0 0 1.2rem 0;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .contact-hero-title span {
    color: #b48940;
  }

  .contact-hero-subtext {
    font-size: 1.65rem !important;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
    color: #ffffff !important;
    line-height: 1.6 !important;
    margin: 0 !important;
    font-weight: 500 !important;
  }

  .contact-hero-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.8rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media screen and (max-width: 989px) {
    .contact-hero-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  .contact-hero-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(180, 137, 64, 0.35);
    border-radius: 16px;
    padding: 2.8rem 2rem;
    text-align: center;
    transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
  }

  .contact-hero-card:hover {
    transform: translateY(-6px);
    border-color: rgba(180, 137, 64, 0.8);
    background: rgba(180, 137, 64, 0.12);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
  }

  .contact-hero-icon-wrap {
    width: 68px;
    height: 68px;
    margin: 0 auto 1.4rem auto;
    background: linear-gradient(135deg, rgba(180, 137, 64, 0.3) 0%, rgba(180, 137, 64, 0.1) 100%);
    border: 1.5px solid rgba(180, 137, 64, 0.6);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #f3d38c;
  }

  .contact-hero-icon-wrap svg {
    width: 32px;
    height: 32px;
    fill: currentColor;
  }

  .contact-hero-card-title {
    font-size: 2.4rem !important;
    font-weight: 400 !important;
    font-family: 'Bebas Neue', 'Anton', sans-serif !important;
    color: #ffffff !important;
    margin: 0 0 0.8rem 0 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
    word-spacing: 0.15em !important;
    line-height: 1.2 !important;
  }

  .contact-hero-card-desc {
    font-size: 1.35rem !important;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
    color: #e2e8f0 !important;
    line-height: 1.6 !important;
    margin: 0 !important;
    font-weight: 400 !important;
  }

  .contact-hero-card-desc strong {
    color: #f3d38c !important;
    font-size: 1.4rem !important;
  }

  /* Social Media Connect Bar on Contact Page */
  .contact-social-bar {
    max-width: 800px;
    margin: 3.5rem auto 0 auto;
    padding: 2.2rem 2rem;
    background: linear-gradient(135deg, rgba(180, 137, 64, 0.15) 0%, rgba(180, 137, 64, 0.04) 100%);
    border: 1px solid rgba(180, 137, 64, 0.4);
    border-radius: 16px;
    text-align: center;
  }

  .contact-social-title {
    font-family: 'Bebas Neue', 'Anton', sans-serif !important;
    font-size: 2.4rem !important;
    color: #b48940 !important;
    letter-spacing: 0.08em !important;
    margin: 0 0 1.5rem 0 !important;
    text-transform: uppercase !important;
  }

  .contact-social-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .contact-social-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 1.1rem 2.2rem;
    border-radius: 50px;
    font-size: 1.35rem;
    font-weight: 700;
    text-decoration: none !important;
    transition: all 0.3s ease;
  }

  .contact-social-btn.instagram-btn {
    background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
    border: none;
    color: #ffffff !important;
    box-shadow: 0 4px 18px rgba(220, 39, 67, 0.4);
  }

  .contact-social-btn.instagram-btn:hover {
    transform: translateY(-3px) scale(1.04);
    box-shadow: 0 8px 25px rgba(220, 39, 67, 0.65);
  }

  .contact-social-btn.tiktok-btn {
    background: #000000;
    border: 1.5px solid #25F4EE;
    color: #ffffff !important;
    box-shadow: 0 0 15px rgba(37, 244, 238, 0.35), inset 0 0 10px rgba(254, 44, 85, 0.2);
  }

  .contact-social-btn.tiktok-btn:hover {
    border-color: #FE2C55;
    transform: translateY(-3px) scale(1.04);
    box-shadow: 0 0 25px rgba(254, 44, 85, 0.6), inset 0 0 10px rgba(37, 244, 238, 0.3);
  }

  .contact-social-btn svg {
    width: 22px !important;
    height: 22px !important;
    max-width: 22px !important;
    max-height: 22px !important;
    flex-shrink: 0 !important;
    fill: currentColor !important;
  }
{%- endstyle -%}

<div class="contact-hero-container-{{ section.id }}">
  <div class="contact-hero-header">
    {% if section.settings.badge_text != blank %}
    <div class="contact-hero-badge">
      <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
      {{ section.settings.badge_text }}
    </div>
    {% endif %}
    {% if section.settings.title != blank %}
    <h1 class="contact-hero-title">{{ section.settings.title }}</h1>
    {% endif %}
    {% if section.settings.subtext != blank %}
    <p class="contact-hero-subtext">
      {{ section.settings.subtext }}
    </p>
    {% endif %}
  </div>

  <div class="contact-hero-grid">
    {% for block in section.blocks %}
      <div class="contact-hero-card" {{ block.shopify_attributes }}>
        <div class="contact-hero-icon-wrap">
          {% if block.settings.icon == 'email' %}
            <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          {% elsif block.settings.icon == 'download' %}
            <svg viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
          {% elsif block.settings.icon == 'guarantee' %}
            <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
          {% endif %}
        </div>
        <h3 class="contact-hero-card-title">{{ block.settings.title }}</h3>
        <p class="contact-hero-card-desc">
          {{ block.settings.description }}
        </p>
      </div>
    {% endfor %}
  </div>

  {% if section.settings.show_social %}
  <!-- Social Media Connect Bar on Contact Page -->
  <div class="contact-social-bar">
    <h3 class="contact-social-title">{{ section.settings.social_title }}</h3>
    <div class="contact-social-buttons">
      {%- if settings.social_instagram_link != blank -%}
        <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" class="contact-social-btn instagram-btn">
          {% render 'icon-instagram' %}
          <span>{{ section.settings.social_instagram_text }}</span>
        </a>
      {%- endif -%}

      {%- if settings.social_tiktok_link != blank -%}
        <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" class="contact-social-btn tiktok-btn">
          {% render 'icon-tiktok' %}
          <span>{{ section.settings.social_tiktok_text }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Contact Hero & Cards",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "24/7 CUSTOMER SUPPORT & ASSISTANCE"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "WE ARE HERE TO HELP YOU <span>TRANSFORM</span>",
      "info": "Use <span> tags to highlight text in gold."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Have questions about the 16-Week Power Balance Training Program, instant digital downloads, or custom workout assistance? Our dedicated support team is available 24/7 to assist you."
    },
    {
      "type": "header",
      "content": "Social Bar"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show Social Media Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "social_title",
      "label": "Social Bar Title",
      "default": "FOLLOW & CONNECT WITH US ON SOCIAL MEDIA"
    },
    {
      "type": "text",
      "id": "social_instagram_text",
      "label": "Instagram Button Text",
      "default": "Instagram (@aztaalli)"
    },
    {
      "type": "text",
      "id": "social_tiktok_text",
      "label": "TikTok Button Text",
      "default": "TikTok (@azta_alli)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "feature_card",
      "name": "Feature Card",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "email", "label": "Email" },
            { "value": "download", "label": "Download" },
            { "value": "guarantee", "label": "Guarantee/Shield" }
          ],
          "default": "email"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Priority Email Support"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Card Description",
          "default": "<p>Direct Help Desk:<br><strong>yourmail@gmail.com</strong><br>Average Response Time: < 2 Hours</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact Hero & Cards",
      "blocks": [
        {
          "type": "feature_card",
          "settings": {
            "icon": "email",
            "title": "Priority Email Support",
            "description": "<p>Direct Help Desk:<br><strong>yourmail@gmail.com</strong><br>Average Response Time: &lt; 2 Hours</p>"
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "icon": "download",
            "title": "Instant Digital Delivery",
            "description": "<p>Immediate PDF & Video Access right after checkout on Mobile, Tablet & Desktop.</p>"
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "icon": "guarantee",
            "title": "30-Day Money Back Guarantee",
            "description": "<p>100% Risk-Free Commitment. Follow the 16-week program with total peace of mind.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
