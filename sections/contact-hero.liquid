{%- style -%}
  .contact-hero-container-{{ section.id }} {
    background-color: #000000;
    color: #ffffff;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  .contact-hero-header {
    text-align: center;
    max-width: 840px;
    margin: 0 auto 3.5rem auto;
    padding: 0 1.5rem;
  }

  .contact-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, rgba(180, 137, 64, 0.25) 0%, rgba(180, 137, 64, 0.08) 100%);
    border: 1.5px solid rgba(180, 137, 64, 0.7);
    color: #f3d38c;
    padding: 12px 28px;
    border-radius: 50px;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    box-shadow: 0 0 20px rgba(180, 137, 64, 0.25);
  }

  .contact-hero-badge svg {
    width: 22px;
    height: 22px;
    fill: #f3d38c;
  }

  .contact-hero-title {
    font-size: clamp(3.2rem, 5vw, 4.5rem);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.15;
    margin: 0 0 1.2rem 0;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .contact-hero-title span {
    color: #b48940;
  }

  .contact-hero-subtext {
    font-size: 1.65rem !important;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
    color: #ffffff !important;
    line-height: 1.6 !important;
    margin: 0 !important;
    font-weight: 500 !important;
  }

  .contact-hero-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.8rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media screen and (max-width: 989px) {
    .contact-hero-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  .contact-hero-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(180, 137, 64, 0.35);
    border-radius: 16px;
    padding: 2.8rem 2rem;
    text-align: center;
    transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
  }

  .contact-hero-card:hover {
    transform: translateY(-6px);
    border-color: rgba(180, 137, 64, 0.8);
    background: rgba(180, 137, 64, 0.12);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
  }

  .contact-hero-icon-wrap {
    width: 68px;
    height: 68px;
    margin: 0 auto 1.4rem auto;
    background: linear-gradient(135deg, rgba(180, 137, 64, 0.3) 0%, rgba(180, 137, 64, 0.1) 100%);
    border: 1.5px solid rgba(180, 137, 64, 0.6);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #f3d38c;
  }

  .contact-hero-icon-wrap svg {
    width: 32px;
    height: 32px;
    fill: currentColor;
  }

  .contact-hero-card-title {
    font-size: 2.4rem !important;
    font-weight: 400 !important;
    font-family: 'Bebas Neue', 'Anton', sans-serif !important;
    color: #ffffff !important;
    margin: 0 0 0.8rem 0 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
    word-spacing: 0.15em !important;
    line-height: 1.2 !important;
  }

  .contact-hero-card-desc {
    font-size: 1.35rem !important;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
    color: #e2e8f0 !important;
    line-height: 1.6 !important;
    margin: 0 !important;
    font-weight: 400 !important;
  }

  .contact-hero-card-desc strong {
    color: #f3d38c !important;
    font-size: 1.4rem !important;
  }

  /* Social Media Connect Bar on Contact Page */
  .contact-social-bar {
    max-width: 800px;
    margin: 3.5rem auto 0 auto;
    padding: 2.2rem 2rem;
    background: linear-gradient(135deg, rgba(180, 137, 64, 0.15) 0%, rgba(180, 137, 64, 0.04) 100%);
    border: 1px solid rgba(180, 137, 64, 0.4);
    border-radius: 16px;
    text-align: center;
  }

  .contact-social-title {
    font-family: 'Bebas Neue', 'Anton', sans-serif !important;
    font-size: 2.4rem !important;
    color: #b48940 !important;
    letter-spacing: 0.08em !important;
    margin: 0 0 1.5rem 0 !important;
    text-transform: uppercase !important;
  }

  .contact-social-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .contact-social-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #000000;
    border: 1.5px solid rgba(180, 137, 64, 0.6);
    color: #ffffff !important;
    padding: 1.1rem 2.2rem;
    border-radius: 50px;
    font-size: 1.35rem;
    font-weight: 700;
    text-decoration: none !important;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
  }

  .contact-social-btn:hover {
    background: #b48940;
    border-color: #b48940;
    color: #000000 !important;
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(180, 137, 64, 0.4);
  }

  .contact-social-btn svg {
    flex-shrink: 0;
  }
{%- endstyle -%}

<div class="contact-hero-container-{{ section.id }}">
  <div class="contact-hero-header">
    <div class="contact-hero-badge">
      <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
      24/7 CUSTOMER SUPPORT & ASSISTANCE
    </div>
    <h1 class="contact-hero-title">WE ARE HERE TO HELP YOU <span>TRANSFORM</span></h1>
    <p class="contact-hero-subtext">
      Have questions about the 16-Week Power Balance Training Program, instant digital downloads, or custom workout assistance? Our dedicated support team is available 24/7 to assist you.
    </p>
  </div>

  <div class="contact-hero-grid">
    <!-- Card 1: Email Support -->
    <div class="contact-hero-card">
      <div class="contact-hero-icon-wrap">
        <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
      </div>
      <h3 class="contact-hero-card-title">Priority Email Support</h3>
      <p class="contact-hero-card-desc">
        Direct Help Desk:<br>
        <strong>yourmail@gmail.com</strong><br>
        Average Response Time: &lt; 2 Hours
      </p>
    </div>

    <!-- Card 2: Instant Access -->
    <div class="contact-hero-card">
      <div class="contact-hero-icon-wrap">
        <svg viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
      </div>
      <h3 class="contact-hero-card-title">Instant Digital Delivery</h3>
      <p class="contact-hero-card-desc">
        Immediate PDF & Video Access right after checkout on Mobile, Tablet & Desktop.
      </p>
    </div>

    <!-- Card 3: 30-Day Guarantee -->
    <div class="contact-hero-card">
      <div class="contact-hero-icon-wrap">
        <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
      </div>
      <h3 class="contact-hero-card-title">30-Day Money Back Guarantee</h3>
      <p class="contact-hero-card-desc">
        100% Risk-Free Commitment. Follow the 16-week program with total peace of mind.
      </p>
    </div>
  </div>

  <!-- Social Media Connect Bar on Contact Page -->
  <div class="contact-social-bar">
    <h3 class="contact-social-title">FOLLOW & CONNECT WITH US ON SOCIAL MEDIA</h3>
    <div class="contact-social-buttons">
      {%- if settings.social_instagram_link != blank -%}
        <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" class="contact-social-btn instagram-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          <span>Instagram (@aztaalli)</span>
        </a>
      {%- endif -%}

      {%- if settings.social_tiktok_link != blank -%}
        <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" class="contact-social-btn tiktok-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 1 1-5.2-1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V6.02a6.4 6.4 0 0 0-1-.08A6.34 6.34 0 0 0 3 12.28a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.53a8.18 8.18 0 0 0 4.78 1.52V6.6a4.85 4.85 0 0 1-0.87.09z"/>
          </svg>
          <span>TikTok (@azta_alli)</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact Hero & Cards",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Contact Hero & Cards"
    }
  ]
}
{% endschema %}
