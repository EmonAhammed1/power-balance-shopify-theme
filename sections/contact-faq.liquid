{%- style -%}
  .contact-faq-section-{{ section.id }} {
    background-color: #000000;
    color: #ffffff;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .contact-faq-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .contact-faq-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .contact-faq-title {
    font-size: clamp(3.2rem, 5vw, 4.5rem);
    font-weight: 900;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-bottom: 0.8rem;
  }

  .contact-faq-title span {
    color: #b48940;
  }

  .contact-faq-subtext {
    font-size: 1.55rem;
    color: #cbd5e1;
    font-weight: 500;
  }

  .contact-faq-item {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(180, 137, 64, 0.3);
    border-radius: 14px;
    margin-bottom: 1.2rem;
    overflow: hidden;
    transition: border-color 0.3s ease;
  }

  .contact-faq-item:hover {
    border-color: rgba(180, 137, 64, 0.7);
  }

  .contact-faq-question {
    width: 100%;
    padding: 1.6rem 2rem;
    background: none;
    border: none;
    color: #ffffff;
    font-size: 1.6rem !important;
    font-weight: 700 !important;
    text-align: left;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
    letter-spacing: 0.01em;
  }

  .contact-faq-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(180, 137, 64, 0.2);
    border: 1px solid rgba(180, 137, 64, 0.5);
    color: #f3d38c;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    line-height: 1;
    transition: transform 0.3s ease, background 0.3s ease;
    flex-shrink: 0;
  }

  .contact-faq-item.active .contact-faq-icon {
    transform: rotate(45deg);
    background: #b48940;
    color: #ffffff;
  }

  .contact-faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease, padding 0.35s ease;
    padding: 0 2rem;
    color: #cbd5e1;
    font-size: 1.35rem !important;
    line-height: 1.6 !important;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
  }

  .contact-faq-item.active .contact-faq-answer {
    max-height: 300px;
    padding: 0 2rem 1.8rem 2rem;
  }
{%- endstyle -%}

<div class="contact-faq-section-{{ section.id }}">
  <div class="contact-faq-inner">
    <div class="contact-faq-header">
      {% if section.settings.title != blank %}
      <h2 class="contact-faq-title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subtext != blank %}
      <p class="contact-faq-subtext">{{ section.settings.subtext }}</p>
      {% endif %}
    </div>

    <div class="contact-faq-list">
      {% for block in section.blocks %}
        <div class="contact-faq-item" {{ block.shopify_attributes }}>
          <button class="contact-faq-question" type="button" onclick="this.parentElement.classList.toggle('active')">
            <span>{{ block.settings.question }}</span>
            <span class="contact-faq-icon">+</span>
          </button>
          <div class="contact-faq-answer">
            {{ block.settings.answer }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact FAQ Accordion",
  "settings": [
    {
      "type": "textarea",
      "id": "title",
      "label": "Heading",
      "default": "FREQUENTLY ASKED <span>QUESTIONS</span>",
      "info": "Use <span> tags to highlight text in gold."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Find quick answers to common questions about the Power Balance 16-Week Program."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How do I access my 16-Week Program after purchase?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Immediately after completing your checkout, you will receive instant digital download links on screen and via email. You can view the full PDF guides and HD exercise execution videos on your smartphone, tablet, or desktop computer.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact FAQ Accordion",
      "blocks": [
