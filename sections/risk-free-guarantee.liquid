{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .guarantee-container-{{ section.id }} {
    background: linear-gradient(185deg, #0d0e12 0%, #13151c 100%);
    border: 1px solid rgba(180, 137, 64, 0.35);
    border-radius: 20px;
    padding: 3.5rem 2rem;
    position: relative;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .guarantee-container-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #b48940, #ffd700, #b48940);
  }

  .guarantee-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3rem auto;
  }

  .guarantee-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(180, 137, 64, 0.15);
    border: 1px solid rgba(180, 137, 64, 0.4);
    color: #ffd700;
    padding: 6px 16px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1.2rem;
  }

  .guarantee-badge svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .guarantee-title {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.15;
    margin: 0 0 1rem 0;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .guarantee-title span {
    color: #b48940;
    background: linear-gradient(135deg, #ffd700 0%, #b48940 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .guarantee-subtext {
    font-size: 1.3rem;
    color: #f1f5f9;
    line-height: 1.6;
    margin: 0;
    font-weight: 500;
  }

  .guarantee-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  @media screen and (max-width: 989px) {
    .guarantee-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 575px) {
    .guarantee-grid {
      grid-template-columns: 1fr;
    }
  }

  .guarantee-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(180, 137, 64, 0.25);
    border-radius: 14px;
    padding: 2rem 1.4rem;
    text-align: center;
    transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease;
  }

  .guarantee-card:hover {
    transform: translateY(-5px);
    border-color: rgba(180, 137, 64, 0.6);
    background: rgba(180, 137, 64, 0.1);
  }

  .guarantee-icon-wrap {
    width: 60px;
    height: 60px;
    margin: 0 auto 1.2rem auto;
    background: linear-gradient(135deg, rgba(180, 137, 64, 0.25) 0%, rgba(180, 137, 64, 0.1) 100%);
    border: 1px solid rgba(180, 137, 64, 0.5);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffd700;
  }

  .guarantee-icon-wrap svg {
    width: 28px;
    height: 28px;
    fill: currentColor;
  }

  .guarantee-card-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.6rem 0;
    letter-spacing: 0.01em;
  }

  .guarantee-card-desc {
    font-size: 1.05rem;
    color: #e2e8f0;
    line-height: 1.6;
    margin: 0;
    font-weight: 400;
  }

  .guarantee-cta-wrap {
    text-align: center;
  }

  .guarantee-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: linear-gradient(135deg, #b48940 0%, #8a6324 100%);
    color: #ffffff !important;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 1.25rem 3.2rem;
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 8px 25px rgba(180, 137, 64, 0.45);
    transition: all 0.3s ease;
  }

  .guarantee-cta-btn:hover {
    background: linear-gradient(135deg, #d4af37 0%, #b48940 100%);
    box-shadow: 0 12px 35px rgba(180, 137, 64, 0.7);
    transform: translateY(-2px);
  }

  .guarantee-cta-btn svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  .guarantee-trust-notes {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-top: 1.4rem;
    font-size: 1.05rem;
    color: #f1f5f9;
    font-weight: 600;
  }

  .guarantee-trust-notes span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .guarantee-trust-notes svg {
    width: 18px;
    height: 18px;
    fill: #22c55e;
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  <div class="guarantee-container-{{ section.id }}">
    
    <div class="guarantee-header">
      <div class="guarantee-badge">
