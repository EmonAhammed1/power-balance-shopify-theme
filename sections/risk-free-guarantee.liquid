      <h2 class="guarantee-title">
        Start Your 16-Week Journey <span>With Complete Confidence</span>
      </h2>
      <p class="guarantee-subtext">
        Get instant digital download access to both Men's and Women's training systems with step-by-step video form execution and progressive tracking.
      </p>
    </div>

    <div class="guarantee-grid">
      <div class="guarantee-card">
        <div class="guarantee-icon-wrap">
          <svg viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
        </div>
        <h3 class="guarantee-card-title">Instant PDF Access</h3>
        <p class="guarantee-card-desc">Download immediately on your phone, tablet or PC right after purchase.</p>
      </div>

      <div class="guarantee-card">
        <div class="guarantee-icon-wrap">
          <svg viewBox="0 0 24 24"><path d="M20.57 14.86L22 13.43 20.57 12 17 15.57 8.43 7 12 3.43 10.57 2 9.14 3.43 7.71 2 6.29 3.43 4.86 2 3.43 3.43 2 4.86 3.43 6.29 2 7.71 3.43 9.14 2 10.57 3.43 12 7 20.57 12 17 13.43 20.57 14.86 22 13.43 20.57z"/></svg>
        </div>
        <h3 class="guarantee-card-title">Men & Women Guides</h3>
        <p class="guarantee-card-desc">Includes tailored 16-week progressive overload routines for both sexes.</p>
      </div>

      <div class="guarantee-card">
        <div class="guarantee-icon-wrap">
          <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
        </div>
        <h3 class="guarantee-card-title">30-Day Guarantee</h3>
        <p class="guarantee-card-desc">Follow the program for 30 days — 100% money back if you see no progress.</p>
      </div>

      <div class="guarantee-card">
        <div class="guarantee-icon-wrap">
          <svg viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
        </div>
        <h3 class="guarantee-card-title">One-Time Payment</h3>
        <p class="guarantee-card-desc">Pay once, keep forever. No hidden monthly subscriptions or extra costs.</p>
      </div>
    </div>

    <div class="guarantee-cta-wrap">
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url | default: '/collections/all' }}" class="guarantee-cta-btn">
        {{ section.settings.button_text | default: 'CLAIM YOUR 16-WEEK PROGRAM TODAY' }}
        <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>

      <div class="guarantee-trust-notes">
        <span>
          <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
          Instant Delivery
        </span>
        <span>
          <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
          256-Bit SSL Encrypted
        </span>
        <span>
          <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
          Lifetime Support
        </span>
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Risk-Free Guarantee",
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "CLAIM YOUR 16-WEEK PROGRAM TODAY"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Risk-Free Guarantee"
    }
  ]
}
{% endschema %}
